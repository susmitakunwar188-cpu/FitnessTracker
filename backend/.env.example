# Fitique Backend - environment variables
# For local development, copy this file to .env in the backend folder.
# For deployment, set these in the Vercel dashboard instead:
#   Project -> Settings -> Environment Variables
# (Vercel injects them at runtime; no .env file is needed there.)

# MongoDB connection string. Required for persistent data on Vercel.
# Use a cloud database (e.g. MongoDB Atlas free tier).
# Without this the app falls back to backend/data/db.json, but Vercel's
# filesystem is read-only/ephemeral, so data will NOT persist.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# Secret used to sign JWTs. Use a long, random string in production.
JWT_SECRET=

# Groq API key used by the Fitique AI chatbot
GROQ_API_KEY=

# Optional - Groq model for the chatbot (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Email delivery (password reset codes) - use a dedicated Gmail account with an
# App Password (Google Account -> Security -> 2-Step Verification -> App passwords).
# SMTP_HOST= smtp.gmail.com
# SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
