# Copy this file to .env (or set these values in the Netlify dashboard) before deploying.
# Local development uses the Vite proxy (/api -> http://localhost:5000), so this can be empty locally.

# URL of your deployed backend API, e.g. https://fitique-backend.vercel.app/api
# (must include the /api path prefix that the backend routes are mounted under)
VITE_API_URL=
